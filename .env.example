# Copy this file to ".env" and fill in your real key.
# NEVER commit or share your real .env file.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_real_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5

# Model used to read uploaded screenshots. Must support vision.
VISION_MODEL=claude-opus-5

# How hard the model thinks before answering: low | medium | high | xhigh | max.
# Higher costs more and takes longer. Answers here are short and grounded in
# retrieved text, so "low" is plenty; screenshot reading gets a step more.
# LLM_EFFORT=low
# VISION_EFFORT=medium

# --- Embeddings -------------------------------------------------------------
# Anthropic has no embeddings endpoint, so this is a separate choice from the
# model above.
# "local"  -- all-MiniLM-L6-v2 on your machine. Free, offline, and what the
#             committed index was built with. Nothing but the Anthropic key
#             is needed.
# "openai" -- text-embedding-3-small. Better retrieval, handles non-English
#             questions well, but needs an OpenAI key on top and costs money on
#             every query and every reindex.
#
# Changing this invalidates the existing index. Rebuild with
# `python scripts/reindex.py` afterwards, or retrieval returns nothing.
EMBEDDING_PROVIDER=local

# Only read when EMBEDDING_PROVIDER=openai. Get a key at
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_real_openai_key_here

# Leave unset to get the right default for the provider above
# (all-MiniLM-L6-v2 for local, text-embedding-3-small for openai).
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Relevance threshold ----------------------------------------------------
# The distance above which a retrieved chunk is discarded. This is what lets
# the app say "I don't know" instead of answering from junk.
#
# It is calibrated per embedding provider and per knowledge base. The built-in
# default for the local provider was measured; the one for openai is an
# estimate. Run `python scripts/check_threshold.py` and set what it suggests:
# MAX_DISTANCE=1.49
