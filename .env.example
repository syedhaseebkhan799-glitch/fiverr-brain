# Copy this file to ".env" and fill in your real key.
# NEVER commit or share your real .env file.

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_real_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Model used to read uploaded screenshots. Must support vision.
VISION_MODEL=gpt-4o-mini

# --- Embeddings -------------------------------------------------------------
# "openai" -- text-embedding-3-small. Better retrieval, handles non-English
#             questions well, costs money on every query and every reindex.
# "local"  -- all-MiniLM-L6-v2 on your machine. Free and offline, weaker.
#
# Changing this invalidates the existing index. Rebuild with
# `python scripts/reindex.py` afterwards, or retrieval returns nothing.
EMBEDDING_PROVIDER=openai

# Leave unset to get the right default for the provider above
# (text-embedding-3-small for openai, all-MiniLM-L6-v2 for local).
# EMBEDDING_MODEL=text-embedding-3-small

# --- Relevance threshold ----------------------------------------------------
# The distance above which a retrieved chunk is discarded. This is what lets
# the app say "I don't know" instead of answering from junk.
#
# It is calibrated per embedding provider and per knowledge base. The built-in
# default for the local provider was measured; the one for openai is an
# estimate. Run `python scripts/check_threshold.py` and set what it suggests:
# MAX_DISTANCE=1.35
